GEOENTITY_ADDR=127.0.0.1:8080
GEOENTITY_DB_PATH=./data/geoentity.db

# Use the browser's exact origin. For local Vite development:
# GEOENTITY_PUBLIC_ORIGIN=http://localhost:5173
# GEOENTITY_DEV_COOKIE_INSECURE=true
GEOENTITY_PUBLIC_ORIGIN=https://localhost:5173
GEOENTITY_DEV_COOKIE_INSECURE=false

# Optional: comma-separated CIDRs for a TLS-terminating proxy that overwrites X-Real-IP.
# Forwarded client headers are ignored unless the direct peer matches one of these CIDRs.
GEOENTITY_TRUSTED_PROXY_CIDRS=

# Operator-managed verified backups; event history is never pruned.
GEOENTITY_BACKUP_DIR=./backups
GEOENTITY_BACKUP_KEEP=10
