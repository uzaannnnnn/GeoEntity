# Base URL for API calls. Defaults to /api which works with Vite proxy in development.
VITE_API_BASE_URL=/api

# Proxy target for Vite dev server when forwarding /api requests
VITE_PROXY_TARGET=http://localhost:8080

# Map Tile Layer URL template. Defaults to the official OpenStreetMap standard tile layer.
# Note: The OSM standard tile service is best-effort with no SLA. Bulk prefetching or offline
# scraping is prohibited. For public production or high-volume usage, configure a commercial
# or self-hosted tile provider with an appropriate SLA and terms of service.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Map tile attribution string (HTML). Defaults to OpenStreetMap contributors attribution.
# Must remain visible and accessible whenever OSM standard tiles or OSM-derived data are shown.
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors

# Maximum zoom level supported by the tile layer (default: 19).
VITE_MAP_MAX_ZOOM=19
